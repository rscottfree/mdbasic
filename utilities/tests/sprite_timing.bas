0 'TURBO MOTION TIMING TEST
1 COLOR 14,0,14:SCREEN CLR
10 LOAD "BIRD.SPR",8,1
20 SPRITE 0,1,6,0
30 PRINT "MOVE TIMING - JIFFIES"
35 FOR A=49280 TO 49290:POKE A,0:NEXT
36 FOR A=49408 TO 49437:READ B:POKE A,B:NEXT
40 FOR I=1 TO 5
50 READ SP
60 MOVE 0,0,100
70 T=TI
80 MOVE 0 TO 344,100,SP
90 SYS 49408
100 D=PEEK(49264)+256*PEEK(49265)+65536*PEEK(49266)-T:IF D<0 THEN D=D+16777216
110 PRINT "SPEED ";SP,D
120 A=49278+I*2:POKE A,D AND 255:POKE A+1,INT(D/256)
130 NEXT
140 POKE 49290,255:PRINT:PRINT "DONE":END
240 DATA 173,0,208,201,88,208,249,173,16,208,41,1,240,242
250 DATA 165,162,141,112,192,165,161,141,113,192,165,160,141,114,192,96
260 DATA 0,64,128,192,255
